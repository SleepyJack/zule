{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "example",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/examples/showcase/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "EXAMPLE_TARGET": "${presetName}"
      }
    },
    {
      "name": "posix",
      "displayName": "The showcase on the host, with the POSIX port",
      "inherits": "example"
    }
  ],
  "buildPresets": [{ "name": "posix", "configurePreset": "posix" }]
}
