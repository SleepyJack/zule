{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Demo with the POSIX port",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/demo-${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON"
      }
    }
  ],
  "buildPresets": [{ "name": "host", "configurePreset": "host" }]
}
