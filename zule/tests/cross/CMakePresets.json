{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "cross",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../build/cross-${presetName}",
      "toolchainFile": "${sourceDir}/../../ports/stub/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "m3",
      "displayName": "Cortex-M3 (Armv7-M), default features",
      "inherits": "cross",
      "cacheVariables": { "CMAKE_C_FLAGS": "-mcpu=cortex-m3 -mthumb" }
    },
    {
      "name": "m3-all",
      "displayName": "Cortex-M3 (Armv7-M), all features",
      "inherits": "cross",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-mcpu=cortex-m3 -mthumb",
        "ZULE_USER_CONFIG_DIR": "${sourceDir}/config_all_on"
      }
    },
    {
      "name": "m0plus",
      "displayName": "Cortex-M0+ (Armv6-M), default features",
      "inherits": "cross",
      "cacheVariables": { "CMAKE_C_FLAGS": "-mcpu=cortex-m0plus -mthumb" }
    },
    {
      "name": "m0plus-all",
      "displayName": "Cortex-M0+ (Armv6-M), all features",
      "inherits": "cross",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-mcpu=cortex-m0plus -mthumb",
        "ZULE_USER_CONFIG_DIR": "${sourceDir}/config_all_on"
      }
    }
  ],
  "buildPresets": [
    { "name": "m3", "configurePreset": "m3" },
    { "name": "m3-all", "configurePreset": "m3-all" },
    { "name": "m0plus", "configurePreset": "m0plus" },
    { "name": "m0plus-all", "configurePreset": "m0plus-all" }
  ]
}
