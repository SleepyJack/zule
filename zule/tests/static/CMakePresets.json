{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 31, "patch": 0 },
  "configurePresets": [
    {
      "name": "static",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../../build/static-${presetName}",
      "toolchainFile": "${sourceDir}/../../ports/cortex_m/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "stub",
      "hidden": true,
      "inherits": "static",
      "cacheVariables": { "ZULE_PORT": "stub" }
    },
    {
      "name": "cortex-m",
      "hidden": true,
      "inherits": "static",
      "cacheVariables": {
        "ZULE_PORT": "cortex_m",
        "ZULE_USER_PORT_CONFIG_DIR": "${sourceDir}/port_config/cortex_m"
      }
    },
    {
      "name": "m3",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_FLAGS": "-mcpu=cortex-m3 -mthumb" }
    },
    {
      "name": "m0plus",
      "hidden": true,
      "cacheVariables": { "CMAKE_C_FLAGS": "-mcpu=cortex-m0plus -mthumb" }
    },
    {
      "name": "all-features",
      "hidden": true,
      "cacheVariables": { "ZULE_USER_CONFIG_DIR": "${sourceDir}/config_all_on" }
    },
    {
      "name": "stub-m3",
      "displayName": "Stub port, Cortex-M3 (Armv7-M), default features",
      "inherits": ["stub", "m3"]
    },
    {
      "name": "stub-m3-all",
      "displayName": "Stub port, Cortex-M3 (Armv7-M), all features",
      "inherits": ["stub", "m3", "all-features"]
    },
    {
      "name": "stub-m0plus",
      "displayName": "Stub port, Cortex-M0+ (Armv6-M), default features",
      "inherits": ["stub", "m0plus"]
    },
    {
      "name": "stub-m0plus-all",
      "displayName": "Stub port, Cortex-M0+ (Armv6-M), all features",
      "inherits": ["stub", "m0plus", "all-features"]
    },
    {
      "name": "cortex-m-m3",
      "displayName": "Cortex-M port, Cortex-M3 (Armv7-M), default features",
      "inherits": ["cortex-m", "m3"]
    },
    {
      "name": "cortex-m-m3-all",
      "displayName": "Cortex-M port, Cortex-M3 (Armv7-M), all features",
      "inherits": ["cortex-m", "m3", "all-features"]
    },
    {
      "name": "cortex-m-m0plus",
      "displayName": "Cortex-M port, Cortex-M0+ (Armv6-M), default features",
      "inherits": ["cortex-m", "m0plus"]
    },
    {
      "name": "cortex-m-m0plus-all",
      "displayName": "Cortex-M port, Cortex-M0+ (Armv6-M), all features",
      "inherits": ["cortex-m", "m0plus", "all-features"]
    }
  ],
  "buildPresets": [
    { "name": "stub-m3", "configurePreset": "stub-m3" },
    { "name": "stub-m3-all", "configurePreset": "stub-m3-all" },
    { "name": "stub-m0plus", "configurePreset": "stub-m0plus" },
    { "name": "stub-m0plus-all", "configurePreset": "stub-m0plus-all" },
    { "name": "cortex-m-m3", "configurePreset": "cortex-m-m3" },
    { "name": "cortex-m-m3-all", "configurePreset": "cortex-m-m3-all" },
    { "name": "cortex-m-m0plus", "configurePreset": "cortex-m-m0plus" },
    { "name": "cortex-m-m0plus-all", "configurePreset": "cortex-m-m0plus-all" }
  ]
}
